# Copy to `.env` and fill in. `docker compose up` refuses to start without
# these, which is the point: a server that boots with a signing key printed in
# its own repository is one that anyone who has read the repository can forge a
# session for.
#
#   cp .env.example .env
#
# `.env` is gitignored. Do not commit it.

# Signs session tokens. Anyone holding it can mint a session for any user, so
# generate it rather than inventing it:
#
#   openssl rand -base64 48
#   # or, without openssl:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Changing it invalidates every existing session, which is also how you revoke
# them all at once.
FORMANCY_AUTH_SECRET=

# The first admin account, created ONLY while no user exists. It cannot re-seed
# an admin into a running installation, so changing these later does nothing —
# use the API to manage users after the first boot.
FORMANCY_ADMIN_EMAIL=
FORMANCY_ADMIN_PASSWORD=

# The development database password. The database is bound to 127.0.0.1, so
# this is a weaker secret than the two above — but it is still a password, and
# a deployment that exposes Postgres beyond the host should set it.
# POSTGRES_PASSWORD=formancy

# Webhook delivery refuses plain http and private addresses, which is what
# stops a form author pointing the server at the cloud metadata service or at
# an internal admin panel. Both are opt-in, per deployment and never per form,
# because the form document is exactly the surface the guard defends against.
#
# Turn them on only for a receiver you run yourself on a trusted network — a
# sidecar on the same host, say. `ALLOW_PRIVATE` gives up the SSRF protection
# entirely for every webhook in the installation.
# FORMANCY_WEBHOOK_ALLOW_HTTP=false
# FORMANCY_WEBHOOK_ALLOW_PRIVATE=false
