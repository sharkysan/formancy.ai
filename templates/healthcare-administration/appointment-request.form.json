        "contactMethod.email": "Email",
        "contactMethod.phone": "Phone",
        "phone": "Phone number",
        "section.2": "Appointment preferences",
        "appointmentType": "Appointment type",
        "appointmentType.first": "First appointment",
        "appointmentType.followup": "Follow-up appointment",
        "appointmentType.administrative": "Administrative appointment",
        "preferredDate": "Preferred date",
        "timePreference": "Preferred time of day",
        "timePreference.morning": "Morning",
        "timePreference.afternoon": "Afternoon",
        "timePreference.either": "Either",
        "language": "Preferred contact language",
        "language.en": "English",
        "language.de": "Deutsch",
        "language.fr": "Français"
      },
