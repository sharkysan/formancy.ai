{
  "specVersion": "2",
  "id": "healthcare-administration-appointment-request",
  "title": "Appointment request",
  "model": {
    "fields": [
      {
        "key": "intro",
        "type": "static",
        "label": {
          "$t": "intro"
        }
      },
      {
        "key": "fullName",
        "type": "text",
        "label": {
          "$t": "fullName"
        },
        "required": true,
        "maxLength": 160
      },
      {
        "key": "email",
        "type": "text",
        "label": {
          "$t": "email"
        },
        "required": true,
        "format": "email",
        "maxLength": 254
      },
      {
        "key": "contactMethod",
        "type": "radio",
        "label": {
          "$t": "contactMethod"
        },
        "required": true,
        "options": [
          {
            "value": "email",
            "label": {
              "$t": "contactMethod.email"
            }
          },
          {
            "value": "phone",
            "label": {
              "$t": "contactMethod.phone"
            }
          }
        ]
      },
      {
        "key": "phone",
        "type": "text",
        "label": {
          "$t": "phone"
        },
        "maxLength": 40
      },
      {
        "key": "appointmentType",
        "type": "select",
        "label": {
          "$t": "appointmentType"
        },
        "required": true,
        "options": [
          {
            "value": "first",
            "label": {
              "$t": "appointmentType.first"
            }
          },
          {
            "value": "followup",
            "label": {
              "$t": "appointmentType.followup"
            }
          },
          {
            "value": "administrative",
            "label": {
              "$t": "appointmentType.administrative"
            }
          }
        ]
      },
      {
        "key": "preferredDate",
        "type": "date",
        "label": {
          "$t": "preferredDate"
        },
        "required": true
      },
      {
        "key": "timePreference",
        "type": "select",
        "label": {
          "$t": "timePreference"
        },
        "required": true,
        "options": [
          {
            "value": "morning",
            "label": {
              "$t": "timePreference.morning"
            }
          },
          {
            "value": "afternoon",
            "label": {
              "$t": "timePreference.afternoon"
            }
          },
          {
            "value": "either",
            "label": {
              "$t": "timePreference.either"
            }
          }
        ]
      },
      {
        "key": "language",
        "type": "select",
        "label": {
          "$t": "language"
        },
        "required": true,
        "options": [
          {
            "value": "en",
            "label": {
              "$t": "language.en"
            }
          },
          {
            "value": "de",
            "label": {
              "$t": "language.de"
            }
          },
          {
            "value": "fr",
            "label": {
              "$t": "language.fr"
            }
          }
        ]
      }
    ]
  },
  "logic": {
    "rules": [
      {
        "target": "phone",
        "kind": "visible",
        "cel": "contactMethod == \"phone\""
      },
      {
        "target": "phone",
        "kind": "required",
        "cel": "contactMethod == \"phone\""
      }
    ]
  },
  "layouts": [
    {
      "name": "web",
      "nodes": [
        {
          "kind": "field",
          "path": "intro"
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.1"
          },
          "children": [
            {
              "kind": "field",
              "path": "fullName"
            },
            {
              "kind": "field",
              "path": "email"
            },
            {
              "kind": "field",
              "path": "contactMethod"
            },
            {
              "kind": "field",
              "path": "phone"
            }
          ]
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.2"
          },
          "children": [
            {
              "kind": "field",
              "path": "appointmentType"
            },
            {
              "kind": "field",
              "path": "preferredDate"
            },
            {
              "kind": "field",
              "path": "timePreference"
            },
            {
              "kind": "field",
              "path": "language"
            }
          ]
        }
      ]
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": {
        "intro": "Send an administrative appointment request. This form is not monitored for urgent care and does not confirm a booking.",
        "section.1": "Contact",
