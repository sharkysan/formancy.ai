        "address": "Adresse postale",
        "language": "Langue préférée",
        "language.en": "English",
        "language.de": "Deutsch",
        "language.fr": "Français",
        "section.2": "Personne remplissant le formulaire",
        "completedBy": "Qui remplit ce formulaire ?",
        "completedBy.self": "Le patient ou la patiente",
