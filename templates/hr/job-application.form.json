{
  "specVersion": "2",
  "id": "hr-job-application",
  "title": "Job application",
  "model": {
    "fields": [
      {
        "key": "aboutYou",
        "type": "page",
        "label": {
          "$t": "page.1"
        },
        "fields": [
          {
            "key": "intro",
            "type": "static",
            "label": {
              "$t": "intro"
            }
          },
          {
            "key": "fullName",
            "type": "text",
            "label": {
              "$t": "fullName"
            },
            "required": true,
            "maxLength": 160
          },
          {
            "key": "email",
            "type": "text",
            "label": {
              "$t": "email"
            },
            "required": true,
            "format": "email",
            "maxLength": 254
          },
          {
            "key": "position",
            "type": "text",
            "label": {
              "$t": "position"
            },
            "required": true,
            "maxLength": 160
          }
        ]
      },
      {
        "key": "yourExperience",
        "type": "page",
        "label": {
          "$t": "page.2"
        },
        "fields": [
          {
            "key": "experience",
            "type": "textarea",
            "label": {
              "$t": "experience"
            },
            "required": true,
            "minLength": 20,
            "maxLength": 4000
          },
          {
            "key": "profileUrl",
            "type": "text",
            "label": {
              "$t": "profileUrl"
            },
            "format": "url",
            "maxLength": 500
          },
          {
            "key": "availableFrom",
            "type": "date",
            "label": {
              "$t": "availableFrom"
            },
            "required": true
          }
        ]
      },
      {
        "key": "interview",
        "type": "page",
        "label": {
          "$t": "page.3"
        },
        "fields": [
          {
            "key": "needsInterviewAdjustment",
            "type": "checkbox",
            "label": {
              "$t": "needsInterviewAdjustment"
            }
          },
          {
            "key": "interviewAdjustment",
            "type": "textarea",
            "label": {
              "$t": "interviewAdjustment"
            },
            "maxLength": 800
          }
        ]
      }
    ]
  },
  "logic": {
    "rules": [
      {
        "target": "interviewAdjustment",
        "kind": "visible",
        "cel": "needsInterviewAdjustment == true"
      },
      {
        "target": "interviewAdjustment",
        "kind": "required",
        "cel": "needsInterviewAdjustment == true"
      }
    ]
  },
  "layouts": [
    {
      "name": "web",
      "nodes": [
        {
          "kind": "field",
          "path": "intro"
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.1"
          },
          "children": [
            {
              "kind": "field",
              "path": "fullName"
            },
            {
              "kind": "field",
              "path": "email"
            },
            {
              "kind": "field",
              "path": "position"
            }
          ]
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.2"
          },
          "children": [
            {
              "kind": "field",
              "path": "experience"
            },
            {
              "kind": "field",
              "path": "profileUrl"
            },
            {
              "kind": "field",
              "path": "availableFrom"
            }
          ]
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.3"
          },
          "children": [
            {
              "kind": "field",
              "path": "needsInterviewAdjustment"
            },
            {
              "kind": "field",
              "path": "interviewAdjustment"
            }
          ]
        }
      ]
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": {
        "intro": "Apply for a role and share relevant experience.",
        "section.1": "Applicant",
        "fullName": "Full name",
        "email": "Email address",
        "position": "Position or reference",
        "section.2": "Experience and availability",
        "experience": "Relevant experience",
        "profileUrl": "CV or portfolio link (optional)",
        "availableFrom": "Available from",
        "needsInterviewAdjustment": "I would like to discuss interview arrangements",
        "interviewAdjustment": "Requested arrangements; no medical details needed",
        "page.1": "About you",
        "page.2": "Experience",
        "page.3": "Interview",
        "section.3": "Interview arrangements"
      },
      "de": {
        "intro": "Bewerben Sie sich auf eine Stelle und beschreiben Sie Ihre relevante Erfahrung.",
        "section.1": "Bewerbende Person",
        "fullName": "Vor- und Nachname",
        "email": "E-Mail-Adresse",
        "position": "Stelle oder Referenz",
        "section.2": "Erfahrung und Verfügbarkeit",
        "experience": "Relevante Erfahrung",
        "profileUrl": "Link zu Lebenslauf oder Portfolio (optional)",
        "availableFrom": "Verfügbar ab",
        "needsInterviewAdjustment": "Ich möchte die Rahmenbedingungen für das Gespräch besprechen",
        "interviewAdjustment": "Gewünschte Rahmenbedingungen; keine medizinischen Angaben nötig",
        "page.1": "Zu Ihrer Person",
        "page.2": "Erfahrung",
        "page.3": "Gespräch",
        "section.3": "Rahmenbedingungen für das Gespräch"
      },
      "fr": {
