        "language.de": "Deutsch",
        "language.fr": "Français",
        "format": "Session format",
        "format.talk": "Talk",
        "format.workshop": "Workshop",
        "durationMinutes": "Requested duration",
        "durationMinutes.20": "20 minutes",
        "durationMinutes.45": "45 minutes",
        "durationMinutes.60": "60 minutes",
        "prerequisites": "Participant prerequisites and equipment"
      },
