        "section.2": "Expense",
        "expenseDate": "Expense date",
        "category": "Expense category",
        "category.travel": "Travel",
        "category.meal": "Business meal",
        "category.supplies": "Supplies",
        "category.other": "Other",
        "purpose": "Business purpose",
        "amount": "Amount paid",
        "currency": "Currency",
        "currency.CHF": "CHF",
        "currency.EUR": "EUR",
        "currency.USD": "USD",
        "receiptReference": "Receipt reference in your document system",
        "travelRoute": "Travel route"
      },
