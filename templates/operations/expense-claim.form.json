{
  "specVersion": "2",
  "id": "operations-expense-claim",
  "title": "Expense claim",
  "model": {
    "fields": [
      {
        "key": "intro",
        "type": "static",
        "label": {
          "$t": "intro"
        }
      },
      {
        "key": "fullName",
        "type": "text",
        "label": {
          "$t": "fullName"
        },
        "required": true,
        "maxLength": 160
      },
      {
        "key": "email",
        "type": "text",
        "label": {
          "$t": "email"
        },
        "required": true,
        "format": "email",
        "maxLength": 254
      },
      {
        "key": "costCentre",
        "type": "text",
        "label": {
          "$t": "costCentre"
        },
        "required": true,
        "maxLength": 100
      },
      {
        "key": "expenseDate",
        "type": "date",
        "label": {
          "$t": "expenseDate"
        },
        "required": true
      },
      {
        "key": "category",
        "type": "select",
        "label": {
          "$t": "category"
        },
        "required": true,
        "options": [
          {
            "value": "travel",
            "label": {
              "$t": "category.travel"
            }
          },
          {
            "value": "meal",
            "label": {
              "$t": "category.meal"
            }
          },
          {
            "value": "supplies",
            "label": {
              "$t": "category.supplies"
            }
          },
          {
            "value": "other",
            "label": {
              "$t": "category.other"
            }
          }
        ]
      },
      {
        "key": "purpose",
        "type": "textarea",
        "label": {
          "$t": "purpose"
        },
        "required": true,
        "minLength": 15,
        "maxLength": 1200
      },
      {
        "key": "amount",
        "type": "number",
        "label": {
          "$t": "amount"
        },
        "required": true,
        "min": 0.01,
        "max": 1000000
      },
      {
        "key": "currency",
        "type": "select",
        "label": {
          "$t": "currency"
        },
        "required": true,
        "options": [
          {
            "value": "CHF",
            "label": {
              "$t": "currency.CHF"
            }
          },
          {
            "value": "EUR",
            "label": {
              "$t": "currency.EUR"
            }
          },
          {
            "value": "USD",
            "label": {
              "$t": "currency.USD"
            }
          }
        ]
      },
      {
        "key": "receiptReference",
        "type": "text",
        "label": {
          "$t": "receiptReference"
        },
        "required": true,
        "maxLength": 200
      },
      {
        "key": "travelRoute",
        "type": "text",
        "label": {
          "$t": "travelRoute"
        },
        "maxLength": 300
      }
    ]
  },
  "logic": {
    "rules": [
      {
        "target": "travelRoute",
        "kind": "visible",
        "cel": "category == \"travel\""
      },
      {
        "target": "travelRoute",
        "kind": "required",
        "cel": "category == \"travel\""
      }
    ]
  },
  "layouts": [
    {
      "name": "web",
      "nodes": [
        {
          "kind": "field",
          "path": "intro"
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.1"
          },
          "children": [
            {
              "kind": "field",
              "path": "fullName"
            },
            {
              "kind": "field",
              "path": "email"
            },
            {
              "kind": "field",
              "path": "costCentre"
            }
          ]
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.2"
          },
          "children": [
            {
              "kind": "field",
              "path": "expenseDate"
            },
            {
              "kind": "field",
              "path": "category"
            },
            {
              "kind": "field",
              "path": "purpose"
            },
            {
              "kind": "field",
              "path": "amount"
            },
            {
              "kind": "field",
              "path": "currency"
            },
            {
              "kind": "field",
              "path": "receiptReference"
            },
            {
              "kind": "field",
              "path": "travelRoute"
            }
          ]
        }
      ]
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": {
        "intro": "Submit one expense with its business purpose and receipt reference.",
        "section.1": "Claimant",
        "fullName": "Full name",
        "email": "Email address",
