        "section.2": "Requested item",
        "item": "Item or service",
        "justification": "Business justification",
        "quantity": "Quantity",
        "unitPrice": "Estimated unit price, excluding tax",
        "currency": "Currency",
        "currency.CHF": "CHF",
        "currency.EUR": "EUR",
        "currency.USD": "USD",
        "estimatedTotal": "Estimated total, excluding tax",
        "preferredSupplier": "I have a preferred supplier",
        "supplier": "Supplier name"
      },
