{
  "specVersion": "2",
  "id": "operations-purchase-request",
  "title": "Purchase request",
  "model": {
    "fields": [
      {
        "key": "intro",
        "type": "static",
        "label": {
          "$t": "intro"
        }
      },
      {
        "key": "fullName",
        "type": "text",
        "label": {
          "$t": "fullName"
        },
        "required": true,
        "maxLength": 160
      },
      {
        "key": "email",
        "type": "text",
        "label": {
          "$t": "email"
        },
        "required": true,
        "format": "email",
        "maxLength": 254
      },
      {
        "key": "costCentre",
        "type": "text",
        "label": {
          "$t": "costCentre"
        },
        "required": true,
        "maxLength": 100
      },
      {
        "key": "item",
        "type": "text",
        "label": {
          "$t": "item"
        },
        "required": true,
        "maxLength": 200
      },
      {
        "key": "justification",
        "type": "textarea",
        "label": {
          "$t": "justification"
        },
        "required": true,
        "minLength": 20,
        "maxLength": 2000
      },
      {
        "key": "quantity",
        "type": "number",
        "label": {
          "$t": "quantity"
        },
        "required": true,
        "min": 0.01,
        "max": 1000000
      },
      {
        "key": "unitPrice",
        "type": "number",
        "label": {
          "$t": "unitPrice"
        },
        "required": true,
        "min": 0,
        "max": 1000000000
      },
      {
        "key": "currency",
        "type": "select",
        "label": {
          "$t": "currency"
        },
        "required": true,
        "options": [
          {
            "value": "CHF",
            "label": {
              "$t": "currency.CHF"
            }
          },
          {
            "value": "EUR",
            "label": {
              "$t": "currency.EUR"
            }
          },
          {
            "value": "USD",
            "label": {
              "$t": "currency.USD"
            }
          }
        ]
      },
      {
        "key": "estimatedTotal",
        "type": "number",
        "label": {
          "$t": "estimatedTotal"
        }
      },
      {
        "key": "preferredSupplier",
        "type": "checkbox",
        "label": {
          "$t": "preferredSupplier"
        }
      },
      {
        "key": "supplier",
        "type": "text",
        "label": {
          "$t": "supplier"
        },
        "maxLength": 200
      }
    ]
  },
  "logic": {
    "rules": [
      {
        "target": "estimatedTotal",
        "kind": "computed",
        "cel": "quantity == null || unitPrice == null ? 0.0 : quantity * unitPrice"
      },
      {
        "target": "estimatedTotal",
        "kind": "disabled",
        "cel": "true"
      },
      {
        "target": "supplier",
        "kind": "visible",
        "cel": "preferredSupplier == true"
      },
      {
        "target": "supplier",
        "kind": "required",
        "cel": "preferredSupplier == true"
      }
    ]
  },
  "layouts": [
    {
      "name": "web",
      "nodes": [
        {
          "kind": "field",
          "path": "intro"
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.1"
          },
          "children": [
            {
              "kind": "field",
              "path": "fullName"
            },
            {
              "kind": "field",
              "path": "email"
            },
            {
              "kind": "field",
              "path": "costCentre"
            }
          ]
        },
        {
          "kind": "section",
          "label": {
            "$t": "section.2"
          },
          "children": [
            {
              "kind": "field",
              "path": "item"
            },
            {
              "kind": "field",
              "path": "justification"
            },
            {
              "kind": "field",
              "path": "quantity"
            },
            {
              "kind": "field",
              "path": "unitPrice"
            },
            {
              "kind": "field",
              "path": "currency"
            },
            {
              "kind": "field",
              "path": "estimatedTotal"
            },
            {
              "kind": "field",
              "path": "preferredSupplier"
            },
            {
              "kind": "field",
              "path": "supplier"
            }
          ]
        }
      ]
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": {
        "intro": "Request one purchase item and review its estimated cost before approval.",
        "section.1": "Requester",
        "fullName": "Full name",
        "email": "Email address",
