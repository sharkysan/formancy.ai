---
/**
 * The title in the documentation's header, pointing OUT of the documentation.
 *
 * Starlight's own `SiteTitle` links to the docs root, which on a one-origin
 * deployment means the header's only link goes to the page you are already on.
 * Measured in the built output before this existed: `<a href="/docs/">` and
 * nothing else in the header — no way to the landing page, no way to the
 * repository. The reference was a place with no exit, on the pages where a
 * visitor is most likely to still be deciding.
 *
 * One origin in production, where the landing page is at `/` and these pages at
 * `/docs/`; two servers in development, where a relative path would land back
 * inside this app. The same reasoning, and the same shape, as the playground's
 * link home.
 */
import mark from '../assets/mark.svg?raw'

const site = import.meta.env.DEV ? 'http://localhost:4384/' : 'https://formancy.ai/'
---

<a class="site-home sl-flex" href={site}>
  <span class="mark" aria-hidden="true" set:html={mark} />
  <span class="name" translate="no">formancy.ai</span>
</a>

<style>
  /* Laid out like Starlight's own title so the override does not announce
     itself: the mark sits where a logo would, at the size Starlight gives one. */
  .site-home {
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .site-home:hover .name {
    text-decoration: underline;
  }

  .mark {
    display: flex;
    flex: none;
    width: var(--sl-nav-height-inner, 1.75rem);
    height: var(--sl-nav-height-inner, 1.75rem);
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
    border-radius: 0.3rem;
  }

  /* The word goes before the mark does. A header that scrolls sideways on a
     phone is worse than one that shows the icon alone. */
  @media (max-width: 30rem) {
    .name {
      display: none;
    }
  }
</style>
