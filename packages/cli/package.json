{
  "name": "@formancy/cli",
  "version": "0.11.0",
  "description": "formancy on the command line: the TypeScript type of what a form's submissions hold.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "formancy": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/spec": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/core": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai",
  "bugs": "https://github.com/sharkysan/formancy.ai/issues"
}
