{
  "name": "@formancy/tiptap",
  "version": "0.1.0",
  "description": "A TipTap editor configured to exactly formancy's rich-text grammar, so it cannot produce anything the grammar cannot store.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/spec": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list-item": "^3.31.3",
    "@tiptap/extension-ordered-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/pm": "^3.31.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "jsdom": "^30.1.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai.git",
    "directory": "packages/tiptap"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai",
  "bugs": "https://github.com/sharkysan/formancy.ai/issues"
}
