{
  "name": "@formancy/expressions",
  "version": "0.0.0",
  "description": "CEL parse, type-check, compile and evaluate, with formancy's safety policy.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  }
}
