{
  "name": "a wizard validates the current page on next and the whole form on submit",
  "description": "Next may only look at the page a person is on: validating pages they have not reached yet would show them errors for questions nobody has asked them. Submit must look at everything, because an answer on a later page can make a field on an earlier one required, and it must take them to the first page that has a problem rather than leaving them on a clean review page staring at a rejection. Pages are presentation: they own no data, so the payload is flat and moving a field between pages is not a data migration.",
  "tags": ["wizard", "validation"],
  "schema": {
    "specVersion": "0",
    "id": "signup",
    "title": "Open an account",
    "model": {
      "fields": [
        {
          "key": "details",
          "type": "page",
          "label": "Your details",
          "fields": [
            { "key": "firstName", "type": "text", "label": "First name", "required": true },
            { "key": "lastName", "type": "text", "label": "Last name", "required": true },
            { "key": "company", "type": "text", "label": "Company" }
          ]
        },
        {
          "key": "address",
          "type": "page",
          "label": "Address",
          "fields": [
            { "key": "street", "type": "text", "label": "Street", "required": true },
            { "key": "city", "type": "text", "label": "City", "required": true },
            {
              "key": "invoiceToCompany",
              "type": "checkbox",
              "label": "Invoice my company"
            }
          ]
        },
        {
          "key": "review",
          "type": "page",
          "label": "Review",
          "fields": [
            {
              "key": "confirm",
              "type": "checkbox",
              "label": "Everything above is correct",
              "required": true
            }
          ]
        }
      ]
    },
    "logic": {
      "rules": [
        { "target": "company", "kind": "required", "cel": "invoiceToCompany == true" }
      ]
    }
  },
  "steps": [
    { "expectPage": "details" },
    { "expectVisible": ["firstName", "lastName", "company"] },
    { "expectHidden": ["street", "city", "confirm"] },
    { "next": true },
    { "expectPage": "details" },
    {
      "expectErrors": {
        "firstName": ["required"],
        "lastName": ["required"],
        "street": [],
        "city": [],
        "confirm": []
      }
    },
    { "set": { "firstName": "Ada", "lastName": "Lovelace" } },
    { "next": true },
    { "expectPage": "address" },
    { "expectNoErrors": true },
    { "back": true },
    { "expectPage": "details" },
    { "expectValue": { "firstName": "Ada" } },
    { "next": true },
    { "expectPage": "address" },
    { "next": true },
    { "expectPage": "address" },
    { "expectErrors": { "street": ["required"], "city": ["required"], "confirm": [] } },
    {
      "set": {
        "street": "Rue de la Gare 1",
        "city": "Lausanne",
        "invoiceToCompany": true
      }
    },
    { "next": true },
    { "expectPage": "review" },
    { "set": { "confirm": true } },
    { "submit": true },
    { "expectSubmit": { "status": "rejected" } },
    { "expectErrors": { "company": ["required"] } },
    { "expectPage": "details" },
    { "set": { "company": "Analytical Engines" } },
    { "next": true },
    { "next": true },
    { "expectPage": "review" },
    { "submit": true },
    {
      "expectSubmit": {
        "status": "accepted",
        "data": {
          "firstName": "Ada",
          "lastName": "Lovelace",
          "company": "Analytical Engines",
          "street": "Rue de la Gare 1",
          "city": "Lausanne",
          "invoiceToCompany": true,
          "confirm": true
        }
      }
    }
  ]
}
