{
  "name": "a hidden value is dropped only when the field asks for it",
  "description": "Retaining by default is the safe direction: someone who ticks a box back on expects to find what they typed. `clearOnHide` is the opt-in for the case where keeping it would submit an answer to a question that was withdrawn. A cleared field leaves no key in the payload at all, rather than a null every consumer then has to special-case.",
  "tags": ["visibility", "data"],
  "schema": {
    "specVersion": "0",
    "id": "order",
    "title": "Place an order",
    "model": {
      "fields": [
        { "key": "hasDetails", "type": "checkbox", "label": "Add delivery details" },
        {
          "key": "notes",
          "type": "textarea",
          "label": "Delivery notes",
          "visibleWhen": "hasDetails",
          "clearOnHide": true
        },
        {
          "key": "reference",
          "type": "text",
          "label": "Order reference",
          "visibleWhen": "hasDetails",
          "clearOnHide": false
        }
      ]
    }
  },
  "steps": [
    { "set": { "hasDetails": true } },
    { "expectVisible": ["notes", "reference"] },
    { "set": { "notes": "Call before noon", "reference": "REF-42" } },
    { "set": { "hasDetails": false } },
    { "expectHidden": ["notes", "reference"] },
    { "submit": true },
    {
      "expectSubmit": {
        "status": "accepted",
        "data": { "hasDetails": false, "reference": "REF-42" }
      }
    },
    { "set": { "hasDetails": true } },
    { "expectValue": { "notes": "", "reference": "REF-42" } }
  ]
}
