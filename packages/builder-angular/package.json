{
  "name": "@formancy/builder-angular",
  "version": "0.3.0",
  "description": "Keyboard-first Angular builder UI for formancy form documents.",
  "license": "Apache-2.0",
  "//exports": [
    "Pointing into dist, so this package is importable from elsewhere in the",
    "workspace. `publishConfig.linkDirectory: false` means the link a sibling",
    "resolves is this directory rather than dist, and without these fields there",
    "is nothing here to resolve: @formancy/builder-angular could not be imported",
    "by any workspace package at all, which is consistent with nothing having",
    "mounted it. @formancy/angular has carried the same two fields all along.",
    "The published manifest is ng-packagr's, in dist, and is unaffected."
  ],
  "exports": {
    ".": {
      "types": "./dist/types/formancy-builder-angular.d.ts",
      "default": "./dist/fesm2022/formancy-builder-angular.mjs"
    }
  },
  "types": "./dist/types/formancy-builder-angular.d.ts",
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/finalize-dist.mjs",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:pkg": "publint ./dist"
  },
  "dependencies": {
    "@formancy/angular": "workspace:*",
    "@formancy/builder-core": "workspace:*",
    "@formancy/core": "workspace:*",
    "@formancy/spec": "workspace:*",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@arethetypeswrong/cli": "catalog:",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "catalog:",
    "dom-accessibility-api": "^0.5.16",
    "jsdom": "^30.1.0",
    "ng-packagr": "^22.1.1",
    "publint": "catalog:",
    "rxjs": "^7.8.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai.git",
    "directory": "packages/builder-angular"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai",
  "bugs": "https://github.com/sharkysan/formancy.ai/issues"
}
