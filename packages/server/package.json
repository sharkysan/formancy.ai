{
  "name": "@formancy/server",
  "version": "0.1.0",
  "description": "The self-hostable formancy backend: Fastify routes and Postgres storage over @formancy/server-core.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "dev": "tsdown && node dist/main.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@formancy/server-core": "workspace:*",
    "@formancy/spec": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai",
  "bugs": "https://github.com/sharkysan/formancy.ai/issues"
}
