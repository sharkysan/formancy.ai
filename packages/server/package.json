{
  "name": "@formancy/server",
  "version": "0.0.0",
  "description": "The self-hostable formancy backend: Fastify routes and Postgres storage over @formancy/server-core.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "dev": "tsdown && node dist/main.mjs"
  },
  "dependencies": {
    "@formancy/server-core": "workspace:*",
    "@formancy/spec": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "@fastify/rate-limit": "^11.2.0",
    "jose": "^6.2.12",
    "@node-rs/argon2": "^2.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  }
}
