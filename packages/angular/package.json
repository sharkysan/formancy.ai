{
  "name": "@formancy/angular",
  "version": "0.3.0",
  "description": "Idiomatic Angular binding for the formancy form engine: signals over the same snapshot protocol.",
  "license": "Apache-2.0",
  "//": "Resolvable from inside the workspace. ng-packagr publishes from dist/ and writes dist/package.json itself, so these describe the SOURCE checkout only: without them @formancy/builder-angular cannot import the renderer it renders a preview with, because nothing else in the workspace had ever imported this package.",
  "types": "./dist/types/formancy-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/formancy-angular.d.ts",
      "default": "./dist/fesm2022/formancy-angular.mjs"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json && node scripts/finalize-dist.mjs",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:pkg": "publint ./dist && attw --pack ./dist --profile esm-only"
  },
  "dependencies": {
    "@formancy/core": "workspace:*",
    "@formancy/spec": "workspace:*",
    "tslib": "^2.8.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/conformance": "workspace:*",
    "@formancy/expressions": "workspace:*",
    "@testing-library/angular": "^19.5.0",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "dom-accessibility-api": "^0.5.16",
    "jsdom": "^30.1.0",
    "ng-packagr": "^22.1.1",
    "publint": "catalog:",
    "rxjs": "^7.8.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai",
  "bugs": "https://github.com/sharkysan/formancy.ai/issues"
}
