{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out-tsc",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@formancy/angular": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "material/src/**/*.ts"
  ]
}
